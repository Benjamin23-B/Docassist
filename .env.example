# ---------------------------------------------------------------------------
# RAG Platform - environment configuration
# Copy to .env and adjust before running `docker compose up`.
# ---------------------------------------------------------------------------

ENVIRONMENT=development
API_PORT=8000

# Comma-separated and JSON-encoded values are parsed as JSON arrays.
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --- PostgreSQL -------------------------------------------------------------
# Used by docker-compose to provision the database.
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
POSTGRES_PORT=5432

# Connection string used by the API and Alembic.
DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag

# --- Redis (Celery broker/result backend and dead-letter queue) -------------
REDIS_URL=redis://localhost:6379/0

# --- Authentication ---------------------------------------------------------
# IMPORTANT: generate a strong secret for anything beyond local development:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-please-change-me-0123456789abcdef
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Object storage (MinIO locally, AWS S3 in production) -------------------
S3_ENDPOINT_URL=http://localhost:9000
# Host-reachable endpoint used inside presigned download URLs.
# In Docker this is usually http://localhost:9000 while the API uses http://minio:9000.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=rag-documents
S3_REGION=us-east-1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Uploads ----------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=[".pdf",".md",".markdown",".txt",".docx",".html",".htm"]
EMBEDDING_DIMENSION=1536

# --- Ingestion pipeline (Phase 2) -------------------------------------------
# Use "deterministic" for offline development, "openai" for real embeddings.
EMBEDDING_PROVIDER=deterministic
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=64
# Required when EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=

CHUNK_SIZE_TOKENS=700
CHUNK_OVERLAP_TOKENS=90
MIN_CHUNK_TOKENS=120
INGESTION_MAX_RETRIES=3
WORKER_CONCURRENCY=2

# --- Celery -----------------------------------------------------------------
# Leave empty to reuse REDIS_URL. Set to true only for tests / single-process demos.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_ALWAYS_EAGER=false
DLQ_KEY=rag:ingestion:dlq

# --- Retrieval & chat (Phase 3) ---------------------------------------------
RETRIEVAL_TOP_K=6
CHAT_HISTORY_LIMIT=8
# Use "deterministic" for offline extractive answers, "openai" for a real LLM.
LLM_PROVIDER=deterministic
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=800
# Delay between deterministic stream tokens (seconds); 0 disables pacing.
LLM_STREAM_DELAY_SECONDS=0.02

# --- Frontend ---------------------------------------------------------------
FRONTEND_PORT=3000
